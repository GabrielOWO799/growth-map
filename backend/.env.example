# 复制为 .env 后按需修改（.env 已被 gitignore，不会提交）

# 数据库连接（默认 SQLite；线上建议用 Postgres，SQLite 在容器里不持久）
DATABASE_URL=sqlite:///./growth.db

# JWT 签名密钥（必填项。生成方式：python -c "import secrets; print(secrets.token_hex(32))"）
# 注意：不设置时仅 DEBUG=True 的本地开发可用临时密钥，线上会拒绝启动
SECRET_KEY=

# 调试模式（True=本地开发，允许 SECRET_KEY 缺省回退；生产环境不要设置）
DEBUG=True

# DeepSeek API 密钥（技能树 AI 推演用；不配置时推演接口返回 503，其余功能不受影响）
DEEPSEEK_API_KEY=
